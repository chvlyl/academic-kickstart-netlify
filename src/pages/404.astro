---
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found | Eric Zhang Chen</title>
  </head>
  <body>
    <main class="page about">
      <h1>Page not found</h1>
      <p class="biography">This page may have moved. You can find my background, experience, and publications on my homepage.</p>
      <p class="biography"><a href={base}>Go to homepage</a></p>
    </main>
  </body>
</html>
